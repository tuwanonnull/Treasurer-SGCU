{
  "hosting": {
    "public": "dist",
    "rewrites": [
      { "source": "/api/push/config", "function": "pushConfig" },
      { "source": "/api/push/subscribe", "function": "subscribePush" },
      { "source": "/api/push/unsubscribe", "function": "unsubscribePush" },
      { "source": "/api/push/test", "function": "testPush" },
      { "source": "/api/push/meeting-event", "function": "dispatchMeetingPush" }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|webp|svg|woff|woff2|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|json|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
